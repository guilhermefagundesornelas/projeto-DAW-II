<%-include('cabecalho.ejs')%>
  <main id="conteudo">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Cuidado para todos os momentos</span>
          <h1>O serviço certo,<br><em>do seu jeito.</em></h1>
          <p>Encontre profissionais de confiança para cuidar do que importa. Simples, seguro e perto de você.</p>
          <form class="search-box" action="/site/servicos" method="post"><span aria-hidden="true">⌕</span><label for="busca" hidden>O que você precisa?</label><input id="busca" name="q" placeholder="O que você precisa hoje?"><button>Buscar serviço</button></form>
          <div class="trust-row"><span>✓ Profissionais verificados</span><span>✓ Pagamento seguro</span></div>
        </div>
        <div class="hero-visual">
          <div class="hero-image-wrap"><img src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&w=900&q=85" alt="Profissional sorridente cuidando da limpeza de uma casa"></div>
          <div class="floating-card rating-card"><strong>★ 4,9</strong><small>média de avaliações</small></div>
          <div class="floating-card professional-card"><strong>Mariana Souza</strong><small>Profissional verificada</small></div>
        </div>
      </div>
    </section>
    <section class="section container">
      <div class="section-heading split"><div><span class="kicker">Explore por categoria</span><h2>Como podemos ajudar?</h2></div><a class="text-link" href="/site/categorias">Ver todas →</a></div>
      <div class="category-grid">
        <% categorias.forEach(function(categoria){ %>
        <a class="category-card" href="/site/servicos/<%=categoria.id%>"><span class="category-icon">★</span><div><strong><%=categoria.nome%></strong></div><span>→</span></a>
        <% }) %>
      </div>
    </section>
    <section class="section muted">
      <div class="container">
        <div class="section-heading split"><div><span class="kicker">Escolhas de quem confia</span><h2>Serviços mais procurados</h2></div><a class="text-link" href="/site/servicos">Ver todos →</a></div>
        <div class="service-grid">
          <% servicos.forEach(function(servico){ %>
            <%
          const nomeCategoria = servico.categoria ? servico.categoria.nome : 'Sem categoria'
          const nomeProfissional = servico.profissional ? servico.profissional.nome : ''
        %>
        <article class="service-card" data-service-card data-category="<%=nomeCategoria%>">
          <div class="service-image">
            <% if (servico.foto) { %><img src="<%=servico.foto%>" alt="<%=servico.nome%>"><% } %>
            <span><%=nomeCategoria%></span>
          </div>
          <div class="service-content">
            <h3><%=servico.nome%></h3>
            <% if (nomeProfissional) { %><p class="professional">por <strong><%=nomeProfissional%></strong></p><% } %>
            <p class="professional"><%=servico.desc%></p>
            <div class="service-meta">
              <span><%=servico.duracao%></span>
              <strong>R$ <%=servico.preco%></strong>
            </div>
            <button class="outline-button"
              data-add="<%=servico.id%>"
              data-nome="<%=servico.nome%>"
              data-categoria="<%=nomeCategoria%>"
              data-profissional="<%=nomeProfissional%>"
              data-duracao="<%=servico.duracao%>"
              data-preco="<%=servico.preco%>">Adicionar ao carrinho +</button>
          </div>
        </article>
          <% }) %>
        </div>
      </div>
    </section>
    <section class="how-section container"><div class="how-copy"><span class="kicker">Feito para facilitar</span><h2>Contrate em poucos passos</h2><p>Você escolhe, combina e acompanha tudo em um só lugar.</p></div><div class="steps"><div class="step"><span class="step-icon">1</span><h3>Encontre</h3><p>Busque pelo serviço que você precisa.</p></div><div class="step"><span class="step-icon">2</span><h3>Agende</h3><p>Escolha o melhor dia e horário.</p></div><div class="step"><span class="step-icon">3</span><h3>Pronto!</h3><p>Acompanhe e avalie a experiência.</p></div></div></section>
  </main>
<%-include('rodape.ejs')%>
