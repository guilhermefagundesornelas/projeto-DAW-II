<%-include('cabecalho.ejs')%>
  <main id="conteudo" class="page container">
    <div class="page-heading"><span class="kicker">Encontre seu profissional</span><h1><%=titulo%></h1><p>Compare opções, avaliações e escolha o atendimento ideal para você.</p></div>
    <form class="catalog-toolbar" action="/site/servicos" method="post">
      <div class="catalog-search"><span aria-hidden="true">⌕</span><input name="q" value="<%=q%>" aria-label="Pesquisar serviços" placeholder="Pesquisar serviços"></div>
      <select name="categoria" aria-label="Filtrar por categoria">
        <option value="">Todos</option>
        <% categorias.forEach(function(categoria){ %>
        <option value="<%=categoria.id%>" <%=categoriaSel === categoria.id ? 'selected' : ''%>><%=categoria.nome%></option>
        <% }) %>
      </select>
      <button class="outline-button" type="submit">Filtrar</button>
    </form>
    <div class="results-line"><strong><%=servicos.length%> <%=servicos.length === 1 ? 'serviço encontrado' : 'serviços encontrados'%></strong><a href="/site/servicos">Limpar filtros</a></div>
    <div class="service-grid catalog">
      <% servicos.forEach(function(servico){ %>
        <%
          const nomeCategoria = servico.categoria ? servico.categoria.nome : 'Sem categoria'
          const nomeProfissional = servico.profissional ? servico.profissional.nome : ''
        %>
        <article class="service-card">
          <div class="service-image">
            <% if (servico.foto) { %><img src="<%=servico.foto%>" alt="<%=servico.nome%>"><% } %>
            <span><%=nomeCategoria%></span>
          </div>
          <div class="service-content">
            <h3><%=servico.nome%></h3>
            <% if (nomeProfissional) { %><p class="professional">por <strong><%=nomeProfissional%></strong></p><% } %>
            <p class="professional"><%=servico.desc%></p>
            <div class="service-meta">
              <span><%=servico.duracao%></span>
              <strong>R$ <%=servico.preco%></strong>
            </div>
            <button class="outline-button"
              data-add="<%=servico.id%>"
              data-nome="<%=servico.nome%>"
              data-categoria="<%=nomeCategoria%>"
              data-profissional="<%=nomeProfissional%>"
              data-duracao="<%=servico.duracao%>"
              data-preco="<%=servico.preco%>">Adicionar ao carrinho +</button>
          </div>
        </article>
      <% }) %>
    </div>
    <% if (servicos.length === 0) { %>
    <div class="empty-state"><h2>Nenhum serviço encontrado</h2><p>Tente buscar por outro termo ou categoria.</p></div>
    <% } %>
  </main>
<%-include('rodape.ejs')%>
