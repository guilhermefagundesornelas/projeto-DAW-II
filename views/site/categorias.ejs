<%-include('cabecalho.ejs')%>
  <main id="conteudo" class="page container">
    <div class="page-heading"><span class="kicker">Tudo em um só lugar</span><h1>Navegue por categorias</h1><p>Do cuidado com a casa ao seu bem-estar, encontre ajuda especializada.</p></div>
    <div class="category-page-grid">
      <% categorias.forEach(function(categoria){ %>
      <a class="category-feature" href="/site/servicos/<%=categoria.id%>"><span class="category-icon">★</span><div><h2><%=categoria.nome%></h2><p>Ver serviços desta categoria</p></div><span class="arrow">→</span></a>
      <% }) %>
    </div>
  </main>
<%-include('rodape.ejs')%>
