<%-include('../cabecalho.ejs')%>
<h1>Editar Profissional</h1>
<div>
<a href="/profissional/lst">Ver Lista de Profissionais</a>
</div>
<div>
    <form  method="post">

        <label>Nome:</label>
        <input type="text" name="nome" required
        value="<%=profissional.nome%>"><br>
         <label>Especialidade:</label>
        <input type="text" name="especialidade" required
        value="<%=profissional.especialidade%>">     <br>
        <label>Anos de Experiência:</label>
        <input type="number" name="anosExperiencia"
        value="<%=profissional.anosExperiencia%>" required><br>
        <br>
        <button type="submit">Editar</button>

    </form>
</div>

<%-include('../rodape.ejs')%>
